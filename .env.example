NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fse:fse_local_only@localhost:5432/fse
DATABASE_SSL=false
PGPOOL_MAX=5
# Generate locally: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ML_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=
# Python ML fetches only an authenticated dataset for the requested user, not database credentials.
CORE_INTERNAL_URL=http://127.0.0.1:3000
# TRUST_PROXY_HOPS=1
# DATABASE_CA=certificate supplied by your database provider
